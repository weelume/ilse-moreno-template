      "files": [
        {
          "path": "src/features/site-templates/catalog/ilse-moreno/content",
          "kind": "directory",
          "purpose": "内容数据"
        },
        {
          "path": "src/features/site-templates/catalog/ilse-moreno/pages",
          "kind": "directory",
          "purpose": "页面组合"
        }
      ],
      "constraints": [
        "保留对应中英文",
        "项目增删后更新元数据和画布坐标"
      ],
      "checks": [
        "typecheck",
        "test"
      ]
    },
    {
      "id": "theme",
      "title": "主题与响应式",
