      "checks": [
        "typecheck",
        "build"
      ]
    },
    {
      "id": "canvas",
      "title": "画布交互",
      "description": "修改缩放、惯性和项目聚焦",
      "files": [
        {
          "path": "src/features/site-templates/catalog/ilse-moreno/canvas-model.ts",
          "kind": "file",
          "purpose": "坐标运算"
        },
        {
          "path": "src/features/site-templates/catalog/ilse-moreno/components/WorkCanvas.tsx",
          "kind": "file",
          "purpose": "交互组件"
        }
      ],
      "constraints": [
        "键盘与触控可操作",
        "保持有界拖拽"
